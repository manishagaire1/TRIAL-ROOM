# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Backend / Database ---
DATABASE_URL=postgresql+psycopg2://virtualfit:virtualfit@localhost:5432/virtualfit

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRY_MINUTES=60

# --- AI Provider ---
# One of: mock | external_api | self_hosted
AI_PROVIDER=mock
AI_PROVIDER_API_KEY=

# --- Storage ---
# One of: local | s3
STORAGE_BACKEND=local
STORAGE_API_KEY=
STORAGE_SECRET=
STORAGE_BUCKET=

# --- URLs ---
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
